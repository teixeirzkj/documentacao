NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Usada apenas na Edge Function / rota server-side de criação de usuários.
# NUNCA exponha esta chave no client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Integração n8n — usada por app/api/integrations/n8n/documentations
N8N_WEBHOOK_SECRET=gere-um-segredo-aleatorio-forte
# id do profile (tabela profiles) que vai assinar como autor das documentações criadas pelo webhook
N8N_AUTOMATION_AUTHOR_ID=uuid-do-profile-de-integracao
